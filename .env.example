# API gateway. One address is enough: it routes /api/products, /api/auctions
# and /hubs/auction to the right microservice.
NEXT_PUBLIC_API_URL=http://localhost:5080

# Skip the SignalR negotiate step (WebSockets only). Turn this on when the
# auction service runs with more than one replica, otherwise leave it off so
# the client can fall back to SSE / long polling.
NEXT_PUBLIC_SIGNALR_SKIP_NEGOTIATION=false
